{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "poc-toolkit",
  "homepage": "https://github.com/Aesirlvu/poc-toolkit",
  "items": [
    {
      "name": "base-kit",
      "type": "registry:item",
      "title": "Base Kit",
      "description": "Has a ui component with @ui placeholder target.",
      "files": [
        {
          "path": "components/ui/demo-badge.tsx",
          "type": "registry:ui",
          "target": "@ui/demo-badge.tsx"
        },
        {
          "path": "components/ui/demo-card.tsx",
          "type": "registry:ui",
          "target": "@ui/demo-card.tsx"
        }
      ]
    },
    {
      "name": "full-setup",
      "type": "registry:item",
      "title": "Full Setup",
      "description": "Depends on base-kit plus a file.",
      "registryDependencies": ["Aesirlvu/poc-toolkit/base-kit"],
      "files": [
        {
          "path": "docs/conventions.md",
          "type": "registry:file",
          "target": "~/docs/conventions.md"
        }
      ]
    }
  ]
}
